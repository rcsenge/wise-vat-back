# Whitelist: ignore everything, then allow only what belongs in the repo.
# New file outside these paths? Add a "!path" line below.
*
!*/

# Root
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/DESIGN.md
!/Makefile
!/.env.example

# Python project
!/pyproject.toml
!/uv.lock
!/Dockerfile
!/.dockerignore
!/docker/**
!/app/**/*.py
!/seed/**/*.py
!/seed/**/*.json
!/seed/documents/*.pdf
!/tests/**/*.py
!/evaluation/**/*.py
!/schemas/**
!/config/**

# Never, even inside whitelisted paths
node_modules/
.venv/
__pycache__/
.DS_Store
