# Whitelist: ignore everything, then allow only what belongs in the repo.
# New file outside these paths? Add a "!path" line below.
*
!*/

# Root
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/DESIGN.md
!/Makefile
!/.env.example

# Backend
!backend/pyproject.toml
!backend/uv.lock
!backend/Dockerfile
!backend/.dockerignore
!backend/docker/**
!backend/app/**/*.py
!backend/seed/**/*.py
!backend/seed/**/*.json
!backend/seed/documents/*.pdf
!backend/tests/**/*.py
!backend/evaluation/**/*.py
!backend/schemas/**
!backend/config/**

# Never, even inside whitelisted paths
node_modules/
.venv/
__pycache__/
.DS_Store
