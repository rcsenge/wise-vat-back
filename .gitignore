# The ignore list is a whitelist.
# Ignore every path by default.
*

# Walk into every directory to find allowed files.
!*/

# Keep the installed dependencies ignored.
node_modules/

# Re-include the project files that this repository tracks.
!*.md
!*.html
!*.css
!/.gitattributes
!frontend/www/*.js
!frontend/www/vendor/globe/*.js
!frontend/www/vendor/globe/*.json
!*.svg
!*.woff2
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!Caddyfile
!docker-compose.yml
!init
!frontend/Dockerfile
!frontend/.dockerignore
!.githooks/**
!.gitignore
!.prettierrc
!.prettierignore

