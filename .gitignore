# The ignore list is a whitelist.
# Ignore every path by default.
*

# Walk into every directory to find allowed files.
!*/

# Keep the installed dependencies ignored.
node_modules/

# Re-include the project files that this repository tracks.
!*.md
!*.html
!*.css
!*.svg
!*.woff2
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.githooks/**
!.gitignore
!.prettierrc
!.prettierignore

# Re-ignore the unused neptune font packs after the whitelist rules.
www/vendor/neptune/fonts/inter/
www/vendor/neptune/fonts/noto-sans-kr/
www/vendor/neptune/fonts/noto-sans-sc/
www/vendor/neptune/fonts/rubik/
www/vendor/neptune/fonts/vazirmatn/
www/vendor/neptune/fonts/zen-kaku-gothic-antique/
www/vendor/neptune/fonts/noto-sans-hebrew-normal.woff2
www/vendor/neptune/fonts/noto-sans-thai-normal.woff2
