#!/bin/sh
# Start the SIGINT demo stack locally for testing.
# It builds the mock database, starts the backend in mock mode, and serves the
# frontend with Caddy. The demo invoice reader replaces Ollama, so no AI model
# and no Docker are required. This lets a human open the frontend and test the
# hardcoded mock invoice JSON payload.
set -eu

BACKEND_PORT="${BACKEND_PORT:-8000}"
FRONTEND_PORT="${FRONTEND_PORT:-8080}"
MOCK_DB_URL="sqlite:///./mock.db"

ROOT="$(CDPATH= cd "$(dirname "$0")" && pwd)"
BACKEND_DIR="$ROOT/backend"
FRONTEND_DIR="$ROOT/frontend"

# Stop every process that listens on one port.
free_port() {
    _port="$1"
    _pids="$(lsof -tiTCP:"$_port" -sTCP:LISTEN 2>/dev/null || true)"
    if [ -n "$_pids" ]; then
        echo "[init] Stopping processes on port $_port: $_pids"
        kill $_pids 2>/dev/null || true
    fi
}

# Wait until an HTTP endpoint answers within a timeout.
wait_until() {
    _url="$1"
    _attempts="${2:-30}"
    while [ "$_attempts" -gt 0 ]; do
        if curl -fsS "$_url" >/dev/null 2>&1; then
            return 0
        fi
        _attempts=$((_attempts - 1))
        sleep 1
    done
    return 1
}

# Check the local prerequisites.
if ! command -v uv >/dev/null 2>&1; then
    echo "uv is missing. Install it with: brew install uv"
    exit 1
fi
if ! command -v caddy >/dev/null 2>&1; then
    echo "Caddy is missing. Install it with: brew install caddy"
    exit 1
fi

# Free the ports first so a second run does not fail on "address in use".
free_port "$BACKEND_PORT"
free_port "$FRONTEND_PORT"

# Build the mock database. It contains the unclaimed transaction for the
# Berlin hotel invoice that the hardcoded mock JSON payload matches.
echo "[init] Building the mock database."
(
    cd "$BACKEND_DIR"
    DATABASE_URL="$MOCK_DB_URL" uv run python -m seed.mock_db
)

# Start the backend in mock mode. The demo reader returns the Berlin invoice,
# so the frontend works without an AI model.
echo "[init] Starting the backend on port $BACKEND_PORT."
(
    cd "$BACKEND_DIR"
    DATABASE_URL="$MOCK_DB_URL" WISE_MODE=mock INVOICE_READER=demo \
        nohup uv run uvicorn app.main:app --host 0.0.0.0 --port "$BACKEND_PORT" \
        >"$ROOT/init-backend.log" 2>&1 &
)

# Start the frontend with Caddy. The Caddyfile resolves www from its own folder.
echo "[init] Serving the frontend on port $FRONTEND_PORT."
(
    cd "$FRONTEND_DIR"
    nohup caddy run --config Caddyfile --adapter caddyfile \
        >"$ROOT/init-frontend.log" 2>&1 &
)

# Wait until the backend and the frontend answer.
if ! wait_until "http://localhost:$BACKEND_PORT/health" 30; then
    echo "[init] The backend did not start. Read init-backend.log."
    exit 1
fi
if ! wait_until "http://localhost:$FRONTEND_PORT/" 30; then
    echo "[init] The frontend did not start. Read init-frontend.log."
    exit 1
fi

echo "[init] The SIGINT demo is running."
echo "[init] Frontend: http://localhost:$FRONTEND_PORT"
echo "[init] Backend:  http://localhost:$BACKEND_PORT"
echo "[init] Logs:     init-backend.log, init-frontend.log"
echo "[init] Stop with: pkill -f 'uvicorn app.main:app'; pkill -f 'caddy run'"
